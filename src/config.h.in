// config.h — Generated by CMake for scrcpy_ffi build
// Equivalent to config.h generated by scrcpy's meson.build.

#ifndef SC_CONFIG_H
#define SC_CONFIG_H

// Version
#define SCRCPY_VERSION "4.1"

// Prefix (unused in FFI build)
#define PREFIX "/usr/local"

// Portable mode disabled
#define PORTABLE 0

// Default port range
#define DEFAULT_LOCAL_PORT_RANGE_FIRST 27183
#define DEFAULT_LOCAL_PORT_RANGE_LAST  27199

// Server debugger disabled
/* #undef SERVER_DEBUGGER */

// V4L2 and USB (HID over AOA) disabled in FFI build
#define HAVE_V4L2 0
#define HAVE_USB  0

// POSIX functions — for macOS with modern Apple Clang
// reallocarray is not exposed in ISO C99 mode on macOS.
// Define as 0 to let scrcpy's compat.c provide the implementation.
#ifdef __APPLE__
#  define HAVE_STRDUP       1
#  define HAVE_ASPRINTF     1
#  define HAVE_VASPRINTF    1
#  define HAVE_NRAND48      1
#  define HAVE_JRAND48      1
#  undef HAVE_REALLOCARRAY     // missing on macOS in strict POSIX mode
#else
#  define HAVE_STRDUP       1
#  define HAVE_ASPRINTF     1
#  define HAVE_VASPRINTF    1
#  define HAVE_NRAND48      1
#  define HAVE_JRAND48      1
#  define HAVE_REALLOCARRAY 1
#endif

// SOCK_CLOEXEC — scrcpy checks the EXISTENCE of the define via #ifdef,
// not its value.
// On macOS: Undefine it so HAVE_SOCK_CLOEXEC is false.
// On Linux: Define it so HAVE_SOCK_CLOEXEC is true.
#ifdef __APPLE__
// macOS does not support SOCK_CLOEXEC — leave entirely undefined
#  undef HAVE_SOCK_CLOEXEC
#else
#  define HAVE_SOCK_CLOEXEC  // Linux has SOCK_CLOEXEC in sys/socket.h
#endif

// SC_NO_SDL — Disables all GUI/SDL drawing dependent code blocks in scrcpy core
#define SC_NO_SDL 1

#endif // SC_CONFIG_H
